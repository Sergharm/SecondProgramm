digraph LinuxSandbox {
  graph [layout=neato, splines=line, bgcolor=white, pad=0.1, dpi=260];
  node [shape=box, color=black, fontcolor=black, fontname="DejaVu Sans", fontsize=11.5, margin="0.09,0.06"];
  edge [color=black, fontname="DejaVu Sans", fontsize=9.5, arrowsize=0.7];
  main [label="main.cpp\nСоздание объектов", pos="342,580!"];
  ui [label="ConsoleUI.cpp / ConsoleUI.h\nВвод команд и вывод результатов", pos="342,520!"];
  sandbox [label="Sandbox.cpp / Sandbox.h\nВыбор и допуск файла,\nуправление анализом, журнал", pos="342,451!"];
  iso [label="IsolationManager.cpp\nIsolationManager.h\nПараметры изоляции", pos="76,354!"];
  process [label="ProcessManager.cpp\nProcessManager.h\nЗапуск и ожидание", pos="252,354!"];
  network [label="NetworkMonitor.cpp\nNetworkMonitor.h\nРазбор сетевой трассы", pos="430,354!"];
  report [label="ReportManager.cpp\nReportManager.h\nСохранение результатов", pos="610,354!"];
  fd [label="FileDescriptor.h\nВладение дескриптором", pos="76,280!"];
  event [label="Event.h\nЗапись сетевого события", pos="430,280!"];
  txt [style=dashed,label="Файлы отчётов\nreports/analysis-XXXXXX.txt", pos="610,280!"];
  bw [style=dashed,label="Bubblewrap\nИзоляция процесса", pos="252,260!"];
  strace [style=dashed,label="strace\nТрассировка сетевых вызовов", pos="252,191!"];
  tcp [label="test_tcp.cpp\nСоединение и обмен TCP", pos="138,119!"];
  udp [label="test_udp.cpp\nОбмен UDP-датаграммами", pos="375,119!"];
  linux [style=dashed,label="Linux API\nПроцессы, дескрипторы и сокеты", pos="252,42!"];
  upper [shape=point, width=0.01, height=0.01, label="", style=invis, pos="500,580!"];
  lower [shape=point, width=0.01, height=0.01, label="", style=invis, pos="500,451!"];
  main -> upper [arrowhead=none,label="создание"];
  upper -> lower [arrowhead=none];
  lower -> sandbox;
  main -> ui [label=" запуск"];
  ui -> sandbox [label=" команды"];
  sandbox -> iso [label=" параметры"];
  sandbox -> process [label=" запуск"];
  sandbox -> network [label=" трасса"];
  sandbox -> report [label=" отчёт"];
  process -> fd;
  network -> event;
  report -> txt;
  process -> bw [label=" execve"];
  bw -> strace;
  strace -> {tcp udp};
  tcp -> linux;
  udp -> linux;
}
